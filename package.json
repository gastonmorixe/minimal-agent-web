{
  "name": "minimal-agent-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "description": "The web host for minimal-agent: a Bun server on @minimal-agent/core and a React chat UI.",
  "homepage": "https://github.com/gastonmorixe/minimal-agent-web",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gastonmorixe/minimal-agent-web.git"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "workspaces": [
    "server",
    "app"
  ],
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "start": "bun run --cwd server start",
    "build": "bun run scripts/bundle-plugins.ts && bun run --cwd app build",
    "test": "bun test",
    "test:e2e": "([ -n \"$CI\" ] && playwright install chromium || true) && playwright test",
    "typecheck": "bun run --cwd server typecheck && bun run --cwd app typecheck && tsc --noEmit -p e2e/tsconfig.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "biome:check": "biome check .",
    "biome:fix": "biome check --write .",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run biome:check && bun run test && bun run build && bun run test:e2e",
    "prepare": "husky",
    "commitlint": "commitlint",
    "commitlint:last": "commitlint --last --verbose"
  },
  "dependencies": {
    "@minimal-agent/core": "git+ssh://git@github.com/gastonmorixe/minimal-agent-core.git#8821f6468ed43326d3f3bc57f0464b85cb88b16f"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "1.56.1",
    "@types/node": "^24",
    "eslint-plugin-jsdoc": "^65.4.5",
    "eslint-plugin-tsdoc": "^0.5.4",
    "husky": "^9.1.7",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "7.0.2"
  }
}
